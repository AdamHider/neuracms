{
    "name": "flatcms/flatcms",
    "description": "FlatCMS - a tiny flat-file CMS for PHP",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "symfony/yaml": "^6.4 || ^7.0",
        "erusev/parsedown": "^1.7",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "FlatCms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlatCms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {}
    }
}
